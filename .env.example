# One deployment per environment. Do not use a production URL for development
# or staging. These values are public client configuration, not credentials.
VITE_APP_ENV=development
VITE_APP_MODE=live
VITE_CONVEX_URL=https://your-development-deployment.convex.cloud

# Public Auth0 application settings; enable its Google connection (google-oauth2).
# Never put a client secret or a Convex deployment key in a VITE_ variable.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=

# Set separately on the Convex deployment (not in frontend variables):
# AUTH0_DOMAIN=<same Auth0 hostname without https:// or a trailing slash>
# AUTH0_CLIENT_ID=<same public application ID>
# CHURCH_MAINTENANCE_ENABLED=false
# CHURCH_DATA_DISPOSABLE=false
# CHURCH_ENV=development

# Local demo is intentionally separate from Convex and is never valid for
# staging or production. Put this in .env.demo.local and start `npm run dev -- --mode demo`.
# VITE_APP_ENV=development
# VITE_APP_MODE=demo
