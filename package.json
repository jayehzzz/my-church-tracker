{
  "name": "church-tracker-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "dev:rehearsal": "vite dev --mode rehearsal",
    "convex:dev": "convex dev",
    "rehearsal:refresh": "python3 scripts/refresh-rehearsal.py",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:backend": "vitest run --config vitest.backend.config.js",
    "check:backend": "tsc -p convex/tsconfig.json",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-auto": "^3.3.1",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/svelte": "^5.2.0",
    "@types/node": "^25.0.9",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.16",
    "convex-test": "^0.0.56",
    "jsdom": "^23.0.0",
    "postcss": "^8.4.32",
    "svelte": "^5.57.0",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "type": "module",
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.24.1",
    "@fontsource/inter": "^5.2.8",
    "convex": "^1.45.0",
    "convex-helpers": "^0.1.123",
    "leaflet": "^1.9.4"
  }
}
