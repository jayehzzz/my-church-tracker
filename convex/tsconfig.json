{
  "compilerOptions": {
    "target": "ESNext", "lib": ["ES2023", "DOM"], "module": "ESNext",
    "moduleResolution": "Bundler", "allowJs": true, "strict": true,
    "skipLibCheck": true, "noEmit": true, "isolatedModules": true,
    "types": ["node", "vite/client"]
  },
  "include": ["./**/*.ts"],
  "exclude": ["./**/*.test.ts"]
}
